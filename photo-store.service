[Unit]
Description=photo-store — what is known about the user's own photos: where each original is, when and where it was taken, a thumbnail and a description
After=network.target

# A systemd user unit: install it to ~/.config/systemd/user/ and the binary to
# ~/bin. %h is the user's home directory, so nothing here names a user.
[Service]
Type=simple
ExecStart=%h/bin/photo-store

# Loopback, deliberately. These are private photos and the service has no auth
# of its own; put a front door that adds it in front. settings.go defaults to
# the same address, so an empty environment is safe too.
Environment=PHOTO_STORE_ADDR=127.0.0.1:8329

WorkingDirectory=%h
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
